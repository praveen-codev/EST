# Copy to .env (gitignored). Generate the secret values with: infra/scripts/gen-keys.sh >> .env
# ── Database (qa profile) ───────────────────────────────────────────────
POSTGRES_DB=est
POSTGRES_USER=est
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
API_PORT=8080

# ── Access tokens (RS256). PEM with literal \n line breaks, or mount files and read them in. ──
EST_JWT_PRIVATE_KEY=
EST_JWT_PUBLIC_KEY=
# 32 random bytes, base64 — encrypts Google refresh tokens at rest (AES-256-GCM)
EST_CRYPTO_KEY=

# ── Tenancy ─────────────────────────────────────────────────────────────
EST_WEB_ORIGINS=http://localhost:3100
EST_ALLOWED_DOMAINS=cognition.ai
EST_BOOTSTRAP_ADMIN_EMAILS=

# ── Google (see infra/runbooks/google-cloud.md) ─────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/calendar/identities/link/callback
