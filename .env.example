# Copy to .env (gitignored). Generate the secret values with: infra/scripts/gen-keys.sh >> .env
# Runtime track: prod or sandbox. Archive has no web/API runtime.
EST_TRACK=prod
# Sandbox must set this false; calendar evidence arrives from the external distributor.
EST_CALENDAR_SYNC_ENABLED=true
# Defaults to est-api-<track>, so prod and sandbox never accept each other's access tokens.
EST_JWT_ISSUER=

# ── Neon (infra/neon/README.md) ─────────────────────────────────────────
# .env.local, .env.sandbox.local and .env.archive.local each hold one project's values.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
EST_DB_POOL_SIZE=4

# ── Devin App launcher (infra/devin-app) ────────────────────────────────
SPRING_PROFILES_ACTIVE=devin-app
EST_ENV_FILE=
EST_DATABASE_URL=
EST_DATABASE_URL_UNPOOLED=
# Defaults to ~/.local/share/est-<profile>; keys there are used only when EST_JWT_* / EST_CRYPTO_KEY are unset.
EST_STATE_DIR=
EST_API_PORT=8080
API_INTERNAL_URL=http://127.0.0.1:8080
PORT=3000

# ── Headless jobs (infra/neon/README.md "Scheduled jobs") ──────────────
# Supply these as protected secrets in the scheduler, never in a committed file.
# Calendar sync job: direct postgres:// URL of the production database (plus EST_CRYPTO_KEY and
# GOOGLE_CLIENT_* below, which must match the production API).
EST_PROD_DATABASE_URL=
EST_SYNC_ORG=org_cognition
# Optional prebuilt boot jar for infra/neon/run-job.sh (default: build with Gradle).
EST_JOB_JAR=

# ── Production → sandbox evidence distributor ───────────────────────────
# Direct postgres:// URLs; when both are set the env files below are not read.
# The source should be a read-only production role.
EST_SOURCE_DATABASE_URL=
EST_SANDBOX_DATABASE_URL=
EST_SOURCE_ENV_FILE=.env.local
EST_SANDBOX_ENV_FILE=.env.sandbox.local
EST_REPLICATION_ORG=org_cognition
EST_REPLICATION_LOOKBACK_DAYS=30
EST_REPLICATION_DRY_RUN=true

# ── Archive migrations ──────────────────────────────────────────────────
EST_ARCHIVE_ENV_FILE=.env.archive.local

# ── Database (qa profile) ───────────────────────────────────────────────
POSTGRES_DB=est
POSTGRES_USER=est
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
API_PORT=8080

# ── Access tokens (RS256). PEM with literal \n line breaks, or mount files and read them in. ──
EST_JWT_PRIVATE_KEY=
EST_JWT_PUBLIC_KEY=
# 32 random bytes, base64 — encrypts Google refresh tokens at rest (AES-256-GCM)
EST_CRYPTO_KEY=

# ── Tenancy ─────────────────────────────────────────────────────────────
EST_WEB_ORIGINS=http://localhost:3100
EST_ALLOWED_DOMAINS=cognition.ai
EST_BOOTSTRAP_ADMIN_EMAILS=

# ── Google (see infra/runbooks/google-cloud.md) ─────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/calendar/identities/link/callback
