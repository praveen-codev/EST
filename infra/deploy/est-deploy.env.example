# ──────────────────────────────────────────────────────────────────────────────
#  EST deployment settings. Copy this file to  ~/est-deploy.env  and fill it in.
#  Every deploy script reads it. Keep it private (it holds passwords).
#  Lines starting with # are comments. Do not put spaces around the = sign.
# ──────────────────────────────────────────────────────────────────────────────

# ── Google Cloud ──
PROJECT_ID=est-prod                      # your Google Cloud project id (lowercase, letters/digits/dashes)
REGION=europe-west1                      # Cloud Run region, e.g. europe-west1, us-central1, asia-south1

# ── Your domain (web and API MUST share one domain) ──
DOMAIN=acme.com
WEB_HOST=app.acme.com
API_HOST=api.acme.com

# ── Who may sign in ──
ALLOWED_DOMAINS=acme.com                 # comma-separated email domains, e.g. acme.com,acme.io
BOOTSTRAP_ADMINS=you@acme.com            # comma-separated; these become admins on first sign-in

# ── Supabase (Project Settings → Database → Connection string → "Session pooler") ──
SUPABASE_PROJECT_REF=abcdefghijklmnop    # the 20-char id in your dashboard URL
SUPABASE_POOLER_HOST=aws-0-eu-west-1.pooler.supabase.com
SUPABASE_DB_PASSWORD=change-me           # the database password you set when creating the project

# ── Google OAuth client (APIs & Services → Credentials) ──
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-change-me
